{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "960px",
            "wideSize": "1320px"
        },
        "color": {
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                {
                    "name": "Base Background",
                    "slug": "base",
                    "color": "#F7F5F0"
                },
                {
                    "name": "Primary Text",
                    "slug": "contrast",
                    "color": "#292A26"
                },
                {
                    "name": "Primary CTA",
                    "slug": "accent-1",
                    "color": "#65735B"
                },
                {
                    "name": "Secondary Background",
                    "slug": "accent-2",
                    "color": "#E7DFD2"
                },
                {
                    "name": "Decorative Accent Border",
                    "slug": "accent-3",
                    "color": "#B6A18A"
                },
                {
                    "name": "Card Surface",
                    "slug": "surface",
                    "color": "#FFFFFF"
                },
                {
                    "name": "Muted Text",
                    "slug": "muted",
                    "color": "#595955"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
                    "name": "Body Sans",
                    "slug": "body"
                },
                {
                    "fontFamily": "Georgia, 'Playfair Display', 'Times New Roman', serif",
                    "name": "Heading Serif",
                    "slug": "heading"
                },
                {
                    "fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                    "name": "UI Sans",
                    "slug": "ui"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small",
                    "fluid": {
                        "min": "0.8125rem",
                        "max": "0.875rem"
                    }
                },
                {
                    "name": "Medium",
                    "size": "1rem",
                    "slug": "medium",
                    "fluid": {
                        "min": "0.9375rem",
                        "max": "1rem"
                    }
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "large",
                    "fluid": {
                        "min": "1.125rem",
                        "max": "1.25rem"
                    }
                },
                {
                    "name": "X-Large",
                    "size": "1.75rem",
                    "slug": "x-large",
                    "fluid": {
                        "min": "1.375rem",
                        "max": "1.75rem"
                    }
                },
                {
                    "name": "XX-Large",
                    "size": "2.5rem",
                    "slug": "xx-large",
                    "fluid": {
                        "min": "1.875rem",
                        "max": "2.5rem"
                    }
                },
                {
                    "name": "Huge",
                    "size": "3.5rem",
                    "slug": "huge",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "3.5rem"
                    }
                }
            ]
        },
        "spacing": {
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ],
            "spacingSizes": [
                {
                    "name": "Tiny",
                    "size": "0.5rem",
                    "slug": "20"
                },
                {
                    "name": "X-Small",
                    "size": "1rem",
                    "slug": "30"
                },
                {
                    "name": "Small",
                    "size": "1.5rem",
                    "slug": "40"
                },
                {
                    "name": "Medium",
                    "size": "clamp(1.5rem, 3vw, 2.5rem)",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "clamp(2rem, 5vw, 4rem)",
                    "slug": "60"
                },
                {
                    "name": "X-Large",
                    "size": "clamp(3rem, 7vw, 6rem)",
                    "slug": "70"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "1.6"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "500",
                    "lineHeight": "1.25"
                },
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--huge)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--xx-large)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--accent-1)"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--contrast)"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--accent-1)",
                    "text": "#FFFFFF"
                },
                "border": {
                    "radius": "2px",
                    "width": "0px"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--ui)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "600",
                    "letterSpacing": "0.05em",
                    "textTransform": "uppercase"
                },
                "spacing": {
                    "padding": {
                        "top": "0.85rem",
                        "bottom": "0.85rem",
                        "left": "1.75rem",
                        "right": "1.75rem"
                    }
                }
            }
        }
    }
}